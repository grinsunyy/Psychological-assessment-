<!DOCTYPE html>

<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>成年人读写障碍筛查量表 · Adult Dyslexia Screening</title>
<meta name="description" content="基于DAST/BDA标准的成年人读写障碍初步筛查工具，涵盖6大维度35道题目">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300;400;600;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
/* ===================== RESET & VARS ===================== */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{
  --ink:#1a1410;--paper:#f5f0e8;--warm:#e8dcc8;--card:#ffffff;
  --accent:#8b2e2e;--accent2:#3d5a6e;--mid:#7a6e5f;--light:#d4c9b4;
  --green:#3a6b4a;--amber:#c17a2a;--red:#8b2e2e;
  --font-serif:'Noto Serif SC',serif;--font-sans:'Noto Sans SC',sans-serif;
}
html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--ink);font-family:var(--font-sans);min-height:100vh;
  background-image:radial-gradient(ellipse at 20% 0%,rgba(139,46,46,.06) 0%,transparent 50%),
  radial-gradient(ellipse at 80% 100%,rgba(61,90,110,.06) 0%,transparent 50%)}

/* ===================== HEADER ===================== */
.site-header{background:var(–ink);color:var(–paper);padding:2.5rem 2rem 2rem;text-align:center;position:relative;overflow:hidden}
.site-header::before{content:’’;position:absolute;inset:0;
background:repeating-linear-gradient(90deg,transparent,transparent 60px,rgba(245,240,232,.03) 60px,rgba(245,240,232,.03) 61px);pointer-events:none}
.badge{display:inline-block;border:1px solid rgba(245,240,232,.3);padding:.3rem 1rem;
font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;color:var(–light);
margin-bottom:1rem;font-weight:300;position:relative}
.site-header h1{font-family:var(–font-serif);font-size:clamp(1.4rem,4vw,2rem);font-weight:600;
letter-spacing:.06em;line-height:1.4;position:relative}
.site-header p{margin-top:.8rem;font-size:.8rem;color:var(–light);font-weight:300;
letter-spacing:.03em;position:relative}

/* ===================== LAYOUT ===================== */
.container{max-width:780px;margin:0 auto;padding:2rem 1.5rem 5rem}

/* ===================== INTRO CARD ===================== */
.intro-card{background:var(–card);border:1px solid var(–light);border-left:4px solid var(–accent2);
padding:1.4rem 1.6rem;margin-bottom:2rem;border-radius:2px}
.intro-card h3{font-family:var(–font-serif);font-size:.9rem;color:var(–accent2);margin-bottom:.6rem;font-weight:600}
.intro-card p,.intro-card li{font-size:.82rem;color:var(–mid);line-height:1.85}
.intro-card ul{padding-left:1.2rem;margin-top:.4rem}
.intro-card strong{color:var(–ink)}

/* ===================== SECTION ===================== */
.section{margin-bottom:2.5rem}
.section-header{display:flex;align-items:center;gap:.8rem;margin-bottom:1.2rem;
padding-bottom:.8rem;border-bottom:2px solid var(–warm)}
.section-num{width:32px;height:32px;background:var(–ink);color:var(–paper);
display:flex;align-items:center;justify-content:center;font-size:.72rem;
font-weight:600;letter-spacing:.05em;flex-shrink:0}
.section-title{font-family:var(–font-serif);font-size:1rem;font-weight:600;color:var(–ink)}
.section-subtitle{font-size:.73rem;color:var(–mid);margin-top:.15rem}

/* ===================== QUESTION ===================== */
.question{background:var(–card);border:1px solid var(–light);border-radius:2px;
padding:1.2rem 1.4rem;margin-bottom:.8rem;transition:border-color .2s,box-shadow .2s;
border-left:3px solid transparent}
.question:hover{border-color:var(–accent2);box-shadow:0 2px 10px rgba(61,90,110,.09)}
.question.answered{border-left-color:var(–green)}
.question.unanswered-warn{border-left-color:var(–accent);animation:shake .3s ease}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-4px)}75%{transform:translateX(4px)}}
.q-text{font-size:.875rem;line-height:1.8;color:var(–ink);margin-bottom:1rem;font-weight:400}
.q-num{display:inline-block;color:var(–accent);font-weight:700;margin-right:.4rem;font-size:.78rem}

/* ===================== OPTIONS ===================== */
.options{display:grid;grid-template-columns:repeat(5,1fr);gap:.45rem}
.options.binary{grid-template-columns:repeat(2,1fr);max-width:260px}
.opt-btn{padding:.55rem .3rem;border:1px solid var(–light);background:var(–paper);
color:var(–mid);font-size:.73rem;font-family:var(–font-sans);cursor:pointer;
border-radius:1px;transition:all .15s;text-align:center;line-height:1.4;
-webkit-tap-highlight-color:transparent}
.opt-btn:hover{border-color:var(–accent2);color:var(–accent2);background:rgba(61,90,110,.06)}
.opt-btn.selected{background:var(–accent2);border-color:var(–accent2);color:#fff;font-weight:500}
.scale-labels{display:flex;justify-content:space-between;font-size:.65rem;
color:var(–mid);margin-top:.4rem;padding:0 .2rem}

/* ===================== SUBMIT AREA ===================== */
.submit-area{text-align:center;margin-top:3rem;padding-top:2rem;border-top:1px solid var(–warm)}
.progress-wrap{max-width:480px;margin:0 auto 1.5rem}
.progress-bar{background:var(–warm);height:5px;border-radius:3px;overflow:hidden;margin-bottom:.6rem}
.progress-fill{height:100%;background:linear-gradient(90deg,var(–accent2),var(–green));
transition:width .35s ease;border-radius:3px;width:0%}
.progress-text{font-size:.78rem;color:var(–mid)}
.btn-submit{background:var(–ink);color:var(–paper);border:none;padding:1rem 3.5rem;
font-family:var(–font-serif);font-size:1rem;font-weight:600;letter-spacing:.08em;
cursor:pointer;transition:all .2s;border-radius:1px}
.btn-submit:hover:not(:disabled){background:var(–accent);transform:translateY(-2px);
box-shadow:0 6px 20px rgba(139,46,46,.3)}
.btn-submit:disabled{opacity:.4;cursor:not-allowed;transform:none}

/* ===================== RESULTS ===================== */
#results{display:none}
.result-header{background:var(–ink);color:var(–paper);padding:2.5rem 2rem 2rem;text-align:center}
.result-header h2{font-family:var(–font-serif);font-size:clamp(1.2rem,3.5vw,1.7rem);font-weight:600;margin-bottom:.5rem}
.result-header p{font-size:.78rem;color:var(–light);margin-top:.4rem}
.result-date{font-size:.7rem;color:rgba(245,240,232,.5);margin-top:.4rem;letter-spacing:.05em}

/* Score summary */
.score-display{display:flex;justify-content:center;gap:1.5rem;margin:1.5rem 0;flex-wrap:wrap}
.score-box{background:var(–card);border:1px solid var(–light);padding:1.2rem 1.6rem;
text-align:center;min-width:110px;flex:0 0 auto}
.score-box .num{font-family:var(–font-serif);font-size:2.2rem;font-weight:700;line-height:1}
.score-box .label{font-size:.7rem;color:var(–mid);margin-top:.4rem;letter-spacing:.04em}
.score-box.total .num{color:var(–accent)}
.score-box.pctbox .num{font-size:1.8rem}
.score-box.levelbox .num{font-size:1.1rem;font-weight:700}

/* Level bar */
.level-bar-wrap{background:var(–card);border:1px solid var(–light);padding:1.4rem;margin-bottom:1.5rem}
.level-bar-title{font-size:.78rem;color:var(–mid);margin-bottom:.8rem;font-weight:500}
.level-track{height:14px;background:var(–warm);border-radius:7px;overflow:hidden;margin-bottom:.5rem;position:relative}
.level-fill{height:100%;border-radius:7px;transition:width 1.2s cubic-bezier(.22,1,.36,1)}
.level-fill.low{background:linear-gradient(90deg,#3a6b4a,#5a9b6a)}
.level-fill.mid{background:linear-gradient(90deg,#c17a2a,#e09b4a)}
.level-fill.high{background:linear-gradient(90deg,#8b2e2e,#c04444)}
.level-marks{display:flex;justify-content:space-between;font-size:.64rem;color:var(–mid)}

/* Radar chart */
.radar-wrap{background:var(–card);border:1px solid var(–light);padding:1.4rem;
margin-bottom:1.5rem;text-align:center}
.radar-title{font-size:.78rem;color:var(–mid);margin-bottom:1rem;font-weight:500;text-align:left}
#radarCanvas{max-width:340px;width:100%;height:auto}

/* Dimension grid */
.dim-section-title{font-family:var(–font-serif);font-size:.88rem;color:var(–mid);
margin-bottom:1rem;letter-spacing:.05em}
.dimension-results{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem}
.dim-card{background:var(–card);border:1px solid var(–light);padding:1.1rem 1.3rem;border-radius:2px}
.dim-card h4{font-size:.78rem;color:var(–mid);margin-bottom:.5rem;font-weight:500;
display:flex;justify-content:space-between;align-items:center}
.dim-card h4 .dim-tag{font-size:.62rem;padding:.1rem .4rem;border-radius:2px;font-weight:600}
.tag-low{background:rgba(58,107,74,.12);color:var(–green)}
.tag-mid{background:rgba(193,122,42,.12);color:var(–amber)}
.tag-high{background:rgba(139,46,46,.12);color:var(–accent)}
.dim-score-bar{height:7px;background:var(–warm);border-radius:4px;overflow:hidden;margin-bottom:.4rem}
.dim-fill{height:100%;border-radius:4px;background:var(–accent2);transition:width 1s ease}
.dim-meta{display:flex;justify-content:space-between;font-size:.68rem;color:var(–mid)}
.dim-desc{font-size:.72rem;color:var(–mid);margin-top:.5rem;line-height:1.6;
border-top:1px solid var(–warm);padding-top:.5rem}

/* Interpretation */
.interpretation{background:var(–card);border:1px solid var(–light);border-left:4px solid var(–accent);
padding:1.4rem 1.6rem;margin-bottom:1.5rem}
.interpretation h3{font-family:var(–font-serif);font-size:.95rem;color:var(–accent);margin-bottom:.8rem}
.interpretation p{font-size:.83rem;line-height:1.95;color:var(–ink)}
.interpretation strong{color:var(–accent)}

/* Key findings */
.findings{background:var(–card);border:1px solid var(–light);padding:1.4rem 1.6rem;margin-bottom:1.5rem}
.findings h3{font-family:var(–font-serif);font-size:.9rem;color:var(–ink);margin-bottom:1rem}
.finding-item{display:flex;gap:.8rem;margin-bottom:.7rem;align-items:flex-start}
.finding-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;margin-top:.4rem}
.finding-dot.alert{background:var(–accent)}
.finding-dot.warn{background:var(–amber)}
.finding-dot.ok{background:var(–green)}
.finding-text{font-size:.82rem;line-height:1.75;color:var(–ink)}

/* Recommendations */
.recommendations{background:var(–card);border:1px solid var(–light);padding:1.4rem 1.6rem;margin-bottom:1.5rem}
.recommendations h3{font-family:var(–font-serif);font-size:.95rem;color:var(–accent2);margin-bottom:.8rem}
.rec-item{display:flex;gap:.8rem;margin-bottom:.75rem;align-items:flex-start}
.rec-icon{width:22px;height:22px;background:var(–accent2);color:#fff;display:flex;
align-items:center;justify-content:center;font-size:.58rem;flex-shrink:0;margin-top:.1rem;border-radius:1px}
.rec-text{font-size:.82rem;line-height:1.75;color:var(–ink)}
.rec-text strong{color:var(–ink)}

/* Disclaimer */
.disclaimer{background:rgba(193,122,42,.08);border:1px solid rgba(193,122,42,.3);
padding:1rem 1.2rem;border-radius:2px;margin-bottom:1.5rem}
.disclaimer p{font-size:.75rem;color:var(–amber);line-height:1.75}

/* Action buttons */
.action-row{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(–warm)}
.btn-retry{background:transparent;color:var(–mid);border:1px solid var(–light);
padding:.75rem 2rem;font-family:var(–font-sans);font-size:.82rem;cursor:pointer;transition:all .2s;border-radius:1px}
.btn-retry:hover{border-color:var(–ink);color:var(–ink)}
.btn-print{background:var(–accent2);color:#fff;border:none;padding:.75rem 2rem;
font-family:var(–font-sans);font-size:.82rem;cursor:pointer;transition:all .2s;border-radius:1px}
.btn-print:hover{background:#2d4a5e;transform:translateY(-1px)}

/* ===================== PRINT ===================== */
@media print{
.site-header,.action-row,.submit-area,#assessment,.btn-print,.btn-retry{display:none!important}
#results{display:block!important}
body{background:#fff}
.container{padding:1rem}
.score-box,.dim-card,.interpretation,.recommendations,.findings,.level-bar-wrap,.radar-wrap{
break-inside:avoid;page-break-inside:avoid}
}

/* ===================== RESPONSIVE ===================== */
@media(max-width:540px){
.options{grid-template-columns:repeat(5,1fr)}
.dimension-results{grid-template-columns:1fr}
.score-display{gap:1rem}
.action-row{flex-direction:column;align-items:center}
}
@media(max-width:380px){
.options{grid-template-columns:repeat(3,1fr)}
.opt-btn{font-size:.68rem;padding:.45rem .2rem}
}
</style>

</head>
