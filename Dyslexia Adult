<script>
/* ============================================================
   DATA & CONFIG
   ============================================================ */
const TOTAL_Q = 35;
const answers = {};

// Dimension config: qs = question numbers, max = maximum score possible
const DIMS = {
  reading:   { qs:[1,2,3,4,5],        max:20, label:'阅读识别', desc:'阅读流畅度、字词解码与视觉追踪能力' },
  writing:   { qs:[6,7,8,9],          max:16, label:'书写拼写', desc:'字形记忆、方向感知与书面表达转换' },
  phonology: { qs:[10,11,12,13],      max:16, label:'语音处理', desc:'音节意识、听觉辨别与语音工作记忆' },
  memory:    { qs:[14,15,16,17,18],   max:20, label:'工作记忆', desc:'短时记忆容量、多任务处理与信息保持' },
  spatial:   { qs:[19,20,21,22],      max:16, label:'方向空间', desc:'左右辨别、顺序感知与空间定向' },
  impact:    { qs:[23,24,25,34],      max:13, label:'生活影响', desc:'对日常工作、情绪及社交的实际影响程度' },
  history:   { qs:[26,27,28,29,30,33], max:6, label:'历史背景', desc:'学习史、家族倾向与早期发育信号' },
};
// Q35 is a control/exclusion question (reversed: vision normal = 0 risk contribution)
// Q31, Q32 are strength indicators, not counted in risk score

const FREQ_LABELS = ['从不','偶尔','有时','经常','总是'];
const BIN_LABELS  = ['是','否'];

/* ============================================================
   BUILD UI
   ============================================================ */
document.querySelectorAll('.options').forEach(container => {
  const q      = container.dataset.q;
  const isBin  = container.dataset.type === 'binary';
  const labels = isBin ? BIN_LABELS : FREQ_LABELS;

  labels.forEach((label, i) => {
    const btn = document.createElement('button');
    btn.className   = 'opt-btn';
    btn.textContent = label;
    btn.type        = 'button';
    // Scoring: freq → 0-4; binary → yes=1, no=0
    const val = isBin ? (i === 0 ? 1 : 0) : i;
    btn.dataset.val = val;
    btn.addEventListener('click', () => selectAnswer(q, val, container, btn));
    container.appendChild(btn);
  });
});

/* ============================================================
   INTERACTION
   ============================================================ */
function selectAnswer(q, val, container, btn) {
  container.querySelectorAll('.opt-btn').forEach(b => b.classList.remove('selected'));
  btn.classList.add('selected');
  answers[q] = parseInt(val, 10);
  const qEl = document.getElementById('q' + q);
  qEl.classList.add('answered');
  qEl.classList.remove('unanswered-warn');
  updateProgress();
}

function updateProgress() {
  const done = Object.keys(answers).length;
  const pct  = (done / TOTAL_Q) * 100;
  document.getElementById('progressFill').style.width  = pct + '%';
  document.getElementById('progressText').textContent  =
    done < TOTAL_Q
      ? `已完成 ${done} / ${TOTAL_Q} 题，还剩 ${TOTAL_Q - done} 题`
      : `全部 ${TOTAL_Q} 题已完成，可生成报告`;
  document.getElementById('submitBtn').disabled = done < TOTAL_Q;
}

/* ============================================================
   SCORING ENGINE
   ============================================================ */
function calcScores() {
  const dimScores = {};
  let totalScore = 0;
  let totalMax   = 0;

  for (const [key, dim] of Object.entries(DIMS)) {
    let score = 0;
    dim.qs.forEach(q => { score += (answers[q] || 0); });
    dimScores[key] = { score, max: dim.max, label: dim.label, desc: dim.desc };
    totalScore += score;
    totalMax   += dim.max;
  }

  // Q35 reverse: if vision is fine (answer=0, meaning "No" = not normal → doesn't contribute)
  // Score is already 0 since it's in 'control' dim which isn't counted. Nothing to subtract.

  return { dimScores, totalScore, totalMax };
}

/* ============================================================
   RADAR CHART (pure Canvas, no dependencies)
   ============================================================ */
function drawRadar(dimScores) {
  const canvas = document.getElementById('radarCanvas');
  const ctx    = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  ctx.clearRect(0, 0, W, H);

  const keys   = Object.keys(DIMS);
  const n      = keys.length;
  const cx     = W / 2, cy = H / 2 + 10;
  const R      = Math.min(W, H) * 0.35;
  const labelR = R + 28;
  const TWO_PI = Math.PI * 2;

  function angle(i) { return (i / n) * TWO_PI - Math.PI / 2; }
  function pt(r, i) {
    return { x: cx + r * Math.cos(angle(i)), y: cy + r * Math.sin(angle(i)) };
  }

  // Background grid levels
  [0.25, 0.5, 0.75, 1.0].forEach(lvl => {
    ctx.beginPath();
    for (let i = 0; i < n; i++) {
      const p = pt(R * lvl, i);
      i === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y);
    }
    ctx.closePath();
    ctx.strokeStyle = lvl === 1.0 ? 'rgba(122,110,95,.25)' : 'rgba(212,201,180,.5)';
    ctx.lineWidth   = lvl === 1.0 ? 1.5 : 1;
    ctx.stroke();
  });

  // Spokes
  for (let i = 0; i < n; i++) {
    const p = pt(R, i);
    ctx.beginPath();
    ctx.moveTo(cx, cy);
    ctx.lineTo(p.x, p.y);
    ctx.strokeStyle = 'rgba(212,201,180,.6)';
    ctx.lineWidth   = 1;
    ctx.stroke();
  }

  // Data polygon
  const vals = keys.map(k => {
    const d = dimScores[k];
    return d ? d.score / d.max : 0;
  });

  ctx.beginPath();
  vals.forEach((v, i) => {
    const p = pt(R * v, i);
    i === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y);
  });
  ctx.closePath();
  ctx.fillStyle   = 'rgba(61,90,110,.18)';
  ctx.fill();
  ctx.strokeStyle = 'rgba(61,90,110,.75)';
  ctx.lineWidth   = 2;
  ctx.stroke();

  // Data points
  vals.forEach((v, i) => {
    const p = pt(R * v, i);
    ctx.beginPath();
    ctx.arc(p.x, p.y, 4, 0, TWO_PI);
    ctx.fillStyle = '#3d5a6e';
    ctx.fill();
    ctx.strokeStyle = '#fff';
    ctx.lineWidth = 1.5;
    ctx.stroke();
  });

  // Labels
  ctx.font      = '11px "Noto Sans SC", sans-serif';
  ctx.fillStyle = '#1a1410';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  keys.forEach((k, i) => {
    const p   = pt(labelR, i);
    const pct = Math.round((dimScores[k]?.score || 0) / DIMS[k].max * 100);
    ctx.fillStyle = '#1a1410';
    ctx.font = '11px "Noto Sans SC", sans-serif';
    ctx.fillText(DIMS[k].label, p.x, p.y - 7);
    ctx.fillStyle = '#3d5a6e';
    ctx.font = '10px "Noto Sans SC", sans-serif';
    ctx.fillText(pct + '%', p.x, p.y + 7);
  });
}

/* ============================================================
   GENERATE REPORT
   ============================================================ */
function generateReport() {
  const { dimScores, totalScore, totalMax } = calcScores();
  const pct = totalScore / totalMax;

  // ── Date ──
  document.getElementById('reportDate').textContent =
    '测评日期：' + new Date().toLocaleDateString('zh-CN', {year:'numeric',month:'long',day:'numeric'});

  // ── Score boxes ──
  document.getElementById('totalScore').textContent = totalScore;
  document.getElementById('maxScore').textContent   = totalMax;
  document.getElementById('pctScore').textContent   = Math.round(pct * 100) + '%';

  let riskLabel, riskColor, fillClass;
  if (pct <= 0.35) {
    riskLabel = '低风险';  riskColor = 'var(--green)'; fillClass = 'low';
  } else if (pct <= 0.60) {
    riskLabel = '中等风险'; riskColor = 'var(--amber)'; fillClass = 'mid';
  } else {
    riskLabel = '高风险';  riskColor = 'var(--accent)'; fillClass = 'high';
  }
  const rl = document.getElementById('riskLevel');
  rl.textContent  = riskLabel;
  rl.style.color  = riskColor;

  // ── Level bar ──
  const fill = document.getElementById('levelFill');
  fill.className        = 'level-fill ' + fillClass;
  fill.style.width      = '0%';
  setTimeout(() => fill.style.width = Math.round(pct * 100) + '%', 80);

  // ── Radar ──
  setTimeout(() => drawRadar(dimScores), 120);

  // ── Dimension cards ──
  const dimContainer = document.getElementById('dimResults');
  dimContainer.innerHTML = '';
  for (const [key, d] of Object.entries(dimScores)) {
    const dp  = d.score / d.max;
    let tag, tagClass;
    if (dp <= 0.35)      { tag = '低'; tagClass = 'tag-low'; }
    else if (dp <= 0.60) { tag = '中'; tagClass = 'tag-mid'; }
    else                 { tag = '高'; tagClass = 'tag-high'; }

    const card = document.createElement('div');
    card.className = 'dim-card';
    card.innerHTML = `
      <h4>${d.label} <span class="dim-tag ${tagClass}">${tag}风险</span></h4>
      <div class="dim-score-bar"><div class="dim-fill" style="width:0%" data-target="${Math.round(dp*100)}%"></div></div>
      <div class="dim-meta"><span>${d.score} / ${d.max} 分</span><span>${Math.round(dp*100)}%</span></div>
      <div class="dim-desc">${d.desc}</div>`;
    dimContainer.appendChild(card);
  }
  setTimeout(() => {
    document.querySelectorAll('.dim-fill').forEach(el => {
      el.style.width = el.dataset.target;
    });
  }, 200);

  // ── Interpretation ──
  let interp = '';
  if (pct <= 0.35) {
    interp = '您的筛查结果处于<strong>低风险范围（得分率 ≤35%）</strong>。当前报告的读写相关困难处于较低水平，整体表现与普通成年人日常体验相符。目前无明显读写障碍迹象。如您对某一特定维度仍有疑虑（尤其是单项维度得分较高），可针对该领域咨询专业人士。';
  } else if (pct <= 0.60) {
    interp = '您的筛查结果处于<strong>中等风险范围（得分率 35–60%）</strong>。您在一定数量的题目上报告了明显的读写相关困难，部分维度的得分提示存在读写障碍的某些特征。这并不等同于确诊，但建议您进一步关注，尤其是当这些困难持续影响工作效率、学习表现或日常生活质量时，寻求专业评估是明智之举。';
  } else {
    interp = '您的筛查结果处于<strong>高风险范围（得分率 >60%）</strong>，多个维度均呈现显著的读写障碍相关特征，且对生活的影响程度较高。读写障碍是一种<strong>神经发育性差异</strong>，与智力水平、努力程度无关，且通过专业支持可以得到有效改善。强烈建议您联系专业心理评估机构，进行包括标准化认知测验在内的全面正式评估。';
  }
  document.getElementById('interpretText').innerHTML = interp;

  // ── Key Findings ──
  const findings = [];
  const highDims = Object.entries(dimScores).filter(([,d]) => d.score/d.max > 0.60);
  const midDims  = Object.entries(dimScores).filter(([,d]) => {const r=d.score/d.max; return r>0.35&&r<=0.60;});

  if (highDims.length > 0) {
    highDims.forEach(([,d]) => {
      findings.push({ level:'alert', text:`<strong>${d.label}</strong>维度得分偏高（${Math.round(d.score/d.max*100)}%），症状表现较为突出，建议重点关注。` });
    });
  }
  if (midDims.length > 0) {
    midDims.forEach(([,d]) => {
      findings.push({ level:'warn', text:`<strong>${d.label}</strong>维度处于中等水平（${Math.round(d.score/d.max*100)}%），存在一定程度的困难迹象。` });
    });
  }
  if (answers[27] === 1) findings.push({ level:'warn',  text:'报告有家族成员存在读写/学习障碍，读写障碍有显著的遗传倾向（遗传率约40–60%）。' });
  if (answers[28] === 1) findings.push({ level:'alert', text:'您曾被正式诊断为读写障碍或相关障碍，本次结果可作为成年期持续症状的参考记录。' });
  if (answers[31] === 1) findings.push({ level:'ok',    text:'您的口头表达能力优于书面表达，这是读写障碍者常见的优势模式，可充分利用。' });
  if (answers[32] === 1) findings.push({ level:'ok',    text:'您在图像思维、创意或空间想象方面有明显优势——这是许多读写障碍者的显著长处。' });
  if (findings.length === 0) {
    findings.push({ level:'ok', text:'各维度得分均处于较低水平，未发现突出的读写障碍风险因素。' });
  }

  document.getElementById('findingsList').innerHTML = findings.map(f =>
    `<div class="finding-item">
      <div class="finding-dot ${f.level}"></div>
      <div class="finding-text">${f.text}</div>
    </div>`).join('');

  // ── Recommendations ──
  const recs = [];
  if (pct > 0.60) {
    recs.push({ icon:'①', text:'<strong>寻求正式诊断：</strong>联系心理评估机构、发展神经学家或语言病理学家，进行WAIS-IV、DAST等标准化评估，获得正式诊断报告以便申请相应支持。' });
    recs.push({ icon:'②', text:'<strong>了解法律保障：</strong>持有诊断报告后，可向用人单位或学校申请合理便利（如考试延时、书面任务替代方案），相关规定可咨询中国残疾人联合会。' });
  }
  if (pct > 0.35) {
    recs.push({ icon:'③', text:'<strong>使用辅助技术：</strong>文字转语音（TTS）、语音输入（如讯飞语音）、电子阅读器（调整字体/行距/背景色）等工具可显著降低读写负担。' });
    recs.push({ icon:'④', text:'<strong>记录困难日志：</strong>连续两周记录哪些情境下读写最困难（时间/场合/任务类型），有助于专业评估和制定个性化策略。' });
    recs.push({ icon:'⑤', text:'<strong>认知补偿策略：</strong>使用思维导图替代文字笔记、将长篇文章转换为音频收听、将复杂任务分解为小步骤——均为有效的自我管理方法。' });
  }
  recs.push({ icon:'⑥', text:'<strong>保护自我认知：</strong>读写障碍者往往在整体思维、创意表达、口语能力和空间想象方面有突出优势，认识并充分发挥这些优势与应对挑战同等重要。' });
  if (pct <= 0.35) {
    recs.push({ icon:'⑦', text:'当前筛查结果处于低风险范围。如未来遇到新的学习或职业挑战时，可再次使用本量表定期评估，及时发现潜在需求。' });
  }

  document.getElementById('recList').innerHTML = recs.map(r =>
    `<div class="rec-item">
      <div class="rec-icon">${r.icon}</div>
      <div class="rec-text">${r.text}</div>
    </div>`).join('');

  // ── Switch view ──
  document.getElementById('assessment').style.display = 'none';
  document.getElementById('results').style.display    = 'block';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

/* ============================================================
   RESET
   ============================================================ */
function resetAssessment() {
  for (const k in answers) delete answers[k];
  document.querySelectorAll('.opt-btn').forEach(b => b.classList.remove('selected'));
  document.querySelectorAll('.question').forEach(q => {
    q.classList.remove('answered', 'unanswered-warn');
  });
  updateProgress();
  document.getElementById('results').style.display    = 'none';
  document.getElementById('assessment').style.display = 'block';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
</script>

