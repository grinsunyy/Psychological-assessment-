<script>
const answers = {};
const TOTAL_Q = 35;

const freqLabels = ['从不', '偶尔', '有时', '经常', '总是'];
const binaryLabels = ['是', '否'];

// Build options
document.querySelectorAll('.options').forEach(container => {
  const q = container.dataset.q;
  const isBinary = container.dataset.type === 'binary';
  const labels = isBinary ? binaryLabels : freqLabels;

  labels.forEach((label, i) => {
    const btn = document.createElement('button');
    btn.className = 'opt-btn';
    btn.textContent = label;
    const val = isBinary ? (i === 0 ? 1 : 0) : i;
    btn.dataset.val = val;
    btn.onclick = () => selectAnswer(q, val, container, btn, isBinary);
    container.appendChild(btn);
  });
});

function selectAnswer(q, val, container, btn, isBinary) {
  container.querySelectorAll('.opt-btn').forEach(b => b.classList.remove('selected'));
  btn.classList.add('selected');
  answers[q] = val;
  document.getElementById('q' + q).classList.add('answered');
  updateProgress();
}

function updateProgress() {
  const done = Object.keys(answers).length;
  const pct = (done / TOTAL_Q) * 100;
  document.getElementById('progressFill').style.width = pct + '%';
  document.getElementById('progressText').textContent = `已完成 ${done} / ${TOTAL_Q} 题`;
  document.getElementById('submitBtn').disabled = done < TOTAL_Q;
}

function generateReport() {
  // Scoring
  // Freq questions (1-25): 0-4 scale, higher = more symptoms
  // Binary (26-35): yes=1, no=0. Q35 (vision ok) is reversed
  
  const dims = {
    reading: { qs: [1,2,3,4,5], max: 20, label: '阅读与文字识别' },
    writing: { qs: [6,7,8,9], max: 16, label: '书写与拼写' },
    phonology: { qs: [10,11,12,13], max: 16, label: '语音处理' },
    memory: { qs: [14,15,16,17,18], max: 20, label: '工作记忆' },
    spatial: { qs: [19,20,21,22], max: 16, label: '方向空间感' },
    impact: { qs: [23,24,25,34], max: 13, label: '生活影响' },
    history: { qs: [26,27,28,29,30,33], max: 6, label: '学习史背景' },
  };

  // Calculate dim scores
  const dimScores = {};
  let totalScore = 0;
  let totalMax = 0;

  for (const [key, dim] of Object.entries(dims)) {
    let score = 0;
    dim.qs.forEach(q => {
      score += (answers[q] || 0);
    });
    dimScores[key] = { score, max: dim.max, label: dim.label };
    totalScore += score;
    totalMax += dim.max;
  }

  const pct = totalScore / totalMax;

  // Render
  document.getElementById('totalScore').textContent = totalScore;
  document.getElementById('maxScore').textContent = totalMax;

  let riskLevel, riskColor, fillClass;
  if (pct < 0.35) {
    riskLevel = '低风险'; riskColor = 'var(--green)'; fillClass = 'low';
  } else if (pct < 0.60) {
    riskLevel = '中等风险'; riskColor = 'var(--amber)'; fillClass = 'mid';
  } else {
    riskLevel = '高风险'; riskColor = 'var(--accent)'; fillClass = 'high';
  }

  document.getElementById('riskLevel').textContent = riskLevel;
  document.getElementById('riskLevel').style.color = riskColor;
  const fill = document.getElementById('levelFill');
  fill.style.width = (pct * 100) + '%';
  fill.className = 'level-fill ' + fillClass;

  // Dim results
  const dimContainer = document.getElementById('dimResults');
  dimContainer.innerHTML = '';
  for (const [key, d] of Object.entries(dimScores)) {
    const p = d.score / d.max;
    dimContainer.innerHTML += `
      <div class="dim-card">
        <h4>${d.label}</h4>
        <div class="dim-score-bar"><div class="dim-fill" style="width:${p*100}%"></div></div>
        <div class="pct">${d.score} / ${d.max}（${Math.round(p*100)}%）</div>
      </div>`;
  }

  // Interpretation
  let interp = '';
  if (pct < 0.35) {
    interp = '您的筛查结果处于<strong>低风险范围</strong>。当前报告的读写相关困难处于较低水平，与典型成年人的日常体验相符。目前无明显读写障碍迹象，但若您对某些特定领域仍有疑虑，可咨询专业人士进一步了解。';
  } else if (pct < 0.60) {
    interp = '您的筛查结果处于<strong>中等风险范围</strong>。您报告了一定程度的读写相关困难，部分维度的得分提示可能存在读写障碍的某些特征。这不一定意味着您有读写障碍，但建议您进一步了解或寻求专业评估，尤其是当这些困难影响到工作或日常生活时。';
  } else {
    interp = '您的筛查结果处于<strong>高风险范围</strong>，多个维度呈现显著的读写障碍相关特征。读写障碍是一种神经发育性差异，与智力水平无关，且是可以得到支持和改善的。建议您尽快联系专业的心理评估机构或特殊教育专家进行正式的标准化诊断评估。';
  }
  document.getElementById('interpretText').innerHTML = interp;

  // Recommendations
  const recs = [];
  if (pct >= 0.60) {
    recs.push({ icon: '★', text: '寻求正式诊断：联系心理评估机构、语言病理学家或特殊教育专家，进行包括标准化测验在内的全面评估（如WAIS、DAST等）。' });
    recs.push({ icon: '◆', text: '了解支持资源：读写障碍协会（如中国残疾人联合会相关机构）可提供读写辅助工具、辅导资源和法律保障信息。' });
  }
  if (pct >= 0.40) {
    recs.push({ icon: '●', text: '使用辅助技术：文字转语音（TTS）、语音输入、电子阅读器等工具可显著减轻读写负担，建议尝试。' });
    recs.push({ icon: '●', text: '记录困难模式：在日常生活中记录哪些情境下读写最为困难，这有助于专业评估时提供更准确的信息。' });
  }
  recs.push({ icon: '○', text: '保护自我认知：读写障碍者往往在创意、口头表达、整体思维等方面具有突出优势，认识到这些优势同样重要。' });
  recs.push({ icon: '○', text: '若目前无明显影响，可定期关注自身读写状况，尤其是面临新的学习或职业挑战时。' });

  const recList = document.getElementById('recList');
  recList.innerHTML = recs.map(r => `
    <div class="rec-item">
      <div class="rec-icon">${r.icon}</div>
      <div class="rec-text">${r.text}</div>
    </div>`).join('');

  // Show results
  document.getElementById('assessment').style.display = 'none';
  document.getElementById('results').style.display = 'block';
  window.scrollTo({ top: 0, behavior: 'smooth' });

  // Animate bars after display
  setTimeout(() => {
    document.querySelectorAll('.dim-fill').forEach(el => {
      const w = el.style.width;
      el.style.width = '0%';
      setTimeout(() => el.style.width = w, 50);
    });
  }, 100);
}

function resetAssessment() {
  Object.keys(answers).forEach(k => delete answers[k]);
  document.querySelectorAll('.opt-btn').forEach(b => b.classList.remove('selected'));
  document.querySelectorAll('.question').forEach(q => q.classList.remove('answered'));
  updateProgress();
  document.getElementById('results').style.display = 'none';
  document.getElementById('assessment').style.display = 'block';
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
</script>

